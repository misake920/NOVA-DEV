# Copie este arquivo para .env e preencha apenas no ambiente seguro.
# Opcional. Chave pública do navegador: restrinja por referrer e Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
# Chave privada de servidor: restrinja à Places API (New).
GOOGLE_PLACES_API_KEY=
# Habilite após revisar os termos aplicáveis ao uso desejado.
ALLOW_GOOGLE_PROSPECTING=false
# Opcional. Provedor compatível com Chat Completions e saída JSON.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
PORT=3001
# Necessário se o proxy de publicação alterar o Host.
APP_ORIGIN=
# PostgreSQL persistente obrigatório na Vercel. Preencha privadamente.
DATABASE_URL=
# Apenas desenvolvimento local; não use SQLite na Vercel.
GHOST_DATABASE_PATH=/workspace/ghost-data/the-ghost.sqlite
