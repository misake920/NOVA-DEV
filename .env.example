# Copie este arquivo para .env e preencha apenas no ambiente seguro.
# Opcional. Chave pública do navegador: restrinja por referrer e Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
# Chave privada de servidor: restrinja à Places API (New).
GOOGLE_PLACES_API_KEY=
# Habilite após revisar os termos aplicáveis ao uso desejado.
ALLOW_GOOGLE_PROSPECTING=false
# Opcional. Provedor compatível com Chat Completions e saída JSON.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
PORT=3001
# Necessário se o proxy de publicação alterar o Host.
APP_ORIGIN=
# Supabase: URL pública do projeto + chave privada, apenas no servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa para projetos que usam a chave service_role legada.
SUPABASE_SERVICE_ROLE_KEY=
# Acesso direto ao seu único workspace, sem cadastro/login no site.
GHOST_ACCESS_MODE=owner
# Apenas um nome de perfil; pode ser alterado dentro do aplicativo.
GHOST_OWNER_NAME=
# Vercel verifica que sua implantação está protegida em All Deployments.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# Opcional: adaptador legado para conexão direta. Não é necessário com Supabase.
DATABASE_URL=
# Apenas desenvolvimento local; não use SQLite na Vercel.
GHOST_DATABASE_PATH=/workspace/ghost-data/the-ghost.sqlite
